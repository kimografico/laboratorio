---
interface Props {
  /** Separación entre triángulos (px) */
  size?: number;
  /** Radio base del triángulo (px) */
  radius?: number;
  /** Distancia de influencia del puntero (px) */
  proximity?: number;
  /** Crecimiento máximo del radio cerca del puntero (px) */
  growth?: number;
  /** Suavizado: cuanto más bajo, más lento y fluido */
  ease?: number;
  /** Giro máximo aleatorio (grados, +/-) al acercarse el puntero */
  rotation?: number;
  /** Color de los triángulos (negro con mucha transparencia) */
  color?: string;
  /** Color de fondo */
  background?: string;
  class?: string;
}

const {
  size = 30,
  radius = 2,
  proximity = 150,
  growth = 12,
  ease = 0.05,
  rotation = 30,
  color = "rgba(0, 0, 0, 0.15)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["triangle-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-radius={radius}
    data-proximity={proximity}
    data-growth={growth}
    data-ease={ease}
    data-rotation={rotation}
    data-color={color}></canvas>
</div>

<style>
  .triangle-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Dot = { x: number; y: number; r: number; grow: number; angle: number; target: number; spin: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const baseRadius = Number(canvas.dataset.radius);
    const proximity = Number(canvas.dataset.proximity);
    const growth = Number(canvas.dataset.growth);
    const ease = Number(canvas.dataset.ease);
    const maxAngle = (Number(canvas.dataset.rotation) * Math.PI) / 180;
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.15)";

    let width = 0;
    let height = 0;
    let dots: Dot[] = [];

    function build() {
      const columns = Math.ceil(width / size) + 1;
      const rows = Math.ceil(height / size) + 1;
      dots = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          dots.push({
            x: col * size,
            y: row * size,
            r: baseRadius,
            grow: 0,
            angle: 0,
            target: 0,
            spin: 0,
          });
        }
      }
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      build();
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      for (const d of dots) {
        const distance = Math.hypot(d.x - px, d.y - py);
        const t = 1 - Math.min(Math.max(distance / proximity, 0), 1);
        // Al entrar en la zona de influencia, cada triángulo elige un giro aleatorio nuevo
        if (t > 0 && d.grow === 0) d.spin = Math.random() * 2 - 1;
        d.grow = t * growth;
        d.target = d.spin * maxAngle * t;
      }
    }

    // Triángulo equilátero apuntando hacia arriba, girado `rot` radianes sobre su centro
    function triangle(x: number, y: number, r: number, rot: number) {
      for (let i = 0; i < 3; i++) {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / 3 + rot;
        const px = x + r * Math.cos(a);
        const py = y + r * Math.sin(a);
        if (i === 0) ctx!.moveTo(px, py);
        else ctx!.lineTo(px, py);
      }
      ctx!.closePath();
    }

    function animate() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.beginPath();
      for (const d of dots) {
        d.r += (baseRadius + d.grow - d.r) * ease;
        d.angle += (d.target - d.angle) * ease * 0.5; // el giro va a la mitad de velocidad que el crecimiento
        triangle(d.x, d.y, Math.max(d.r, 0), d.angle);
      }
      ctx!.fillStyle = color;
      ctx!.fill();
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document
    .querySelectorAll<HTMLCanvasElement>(".triangle-background canvas")
    .forEach(setup);
</script>
