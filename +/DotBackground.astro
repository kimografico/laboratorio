---
interface Props {
  /** Separación entre puntos (px) */
  size?: number;
  /** Radio base del punto (px) */
  radius?: number;
  /** Distancia de influencia del puntero (px) */
  proximity?: number;
  /** Desplazamiento máximo al ser repelido (px) */
  push?: number;
  /** Rigidez del muelle: más alto, vuelve antes */
  stiffness?: number;
  /** Amortiguación (0-1): más alto, más rebote */
  damping?: number;
  color?: string;
  background?: string;
  class?: string;
}

const {
  size = 28,
  radius = 1.5,
  proximity = 160,
  push = 22,
  stiffness = 0.04,
  damping = 0.85,
  color = "rgba(0, 0, 0, 0.2)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["dot-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-radius={radius}
    data-proximity={proximity}
    data-push={push}
    data-stiffness={stiffness}
    data-damping={damping}
    data-color={color}></canvas>
</div>

<style>
  .dot-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Dot = { hx: number; hy: number; x: number; y: number; vx: number; vy: number; r: number; tx: number; ty: number; tr: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const baseRadius = Number(canvas.dataset.radius);
    const proximity = Number(canvas.dataset.proximity);
    const push = Number(canvas.dataset.push);
    const stiffness = Number(canvas.dataset.stiffness);
    const damping = Number(canvas.dataset.damping);
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.2)";

    let width = 0;
    let height = 0;
    let dots: Dot[] = [];

    function build() {
      const columns = Math.ceil(width / size) + 1;
      const rows = Math.ceil(height / size) + 1;
      dots = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          const x = col * size;
          const y = row * size;
          dots.push({ hx: x, hy: y, x, y, vx: 0, vy: 0, r: baseRadius, tx: x, ty: y, tr: baseRadius });
        }
      }
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      build();
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      for (const d of dots) {
        const ax = d.hx - px;
        const ay = d.hy - py;
        const distance = Math.hypot(ax, ay) || 1;
        const t = 1 - Math.min(distance / proximity, 1);
        // El punto es empujado en dirección contraria al puntero
        d.tx = d.hx + (ax / distance) * push * t;
        d.ty = d.hy + (ay / distance) * push * t;
        d.tr = baseRadius + 1.5 * t;
      }
    }

    function animate() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.beginPath();
      for (const d of dots) {
        d.vx = (d.vx + (d.tx - d.x) * stiffness) * damping;
        d.vy = (d.vy + (d.ty - d.y) * stiffness) * damping;
        d.x += d.vx;
        d.y += d.vy;
        d.r += (d.tr - d.r) * 0.08;
        ctx!.moveTo(d.x + d.r, d.y);
        ctx!.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      }
      ctx!.fillStyle = color;
      ctx!.fill();
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".dot-background canvas").forEach(setup);
</script>
