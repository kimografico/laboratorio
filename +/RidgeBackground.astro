---
interface Props {
  /** Separación entre líneas (px) */
  spacing?: number;
  /** Altura máxima de la elevación bajo el puntero (px) */
  lift?: number;
  /** Radio de la elevación (px) */
  radius?: number;
  /** Rugosidad (0-1): 0 = colina suave y redonda, 1 = montañas aserradas con ruido */
  roughness?: number;
  /** Variación entre filas (0-1): cuánto se diferencia cada línea de sus vecinas. Solo actúa con roughness > 0; 0 = filas casi paralelas */
  variation?: number;
  /** Amplitud de la ondulación ambiental (px) */
  idle?: number;
  /** Suavizado con el que la elevación sigue al puntero */
  ease?: number;
  lineWidth?: number;
  /** Color de las líneas (con transparencia) */
  color?: string;
  /** Debe coincidir con el fondo: tapa las líneas que quedan detrás de las crestas */
  background?: string;
  class?: string;
}

const {
  spacing = 18,
  lift = 52,
  radius = 180,
  roughness = 0,
  variation = 0.35,
  idle = 4,
  ease = 0.06,
  lineWidth = 1,
  color = "rgba(0, 0, 0, 0.3)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["ridge-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-spacing={spacing}
    data-lift={lift}
    data-radius={radius}
    data-roughness={roughness}
    data-variation={variation}
    data-idle={idle}
    data-ease={ease}
    data-line-width={lineWidth}
    data-color={color}
    data-background={background}></canvas>
</div>

<style>
  .ridge-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Ruido de valor 1D (determinista, sin dependencias)
  const hash = (n: number) => {
    const s = Math.sin(n * 127.1) * 43758.5453;
    return s - Math.floor(s);
  };
  const vnoise = (x: number) => {
    const i = Math.floor(x);
    const f = x - i;
    const u = f * f * (3 - 2 * f);
    return hash(i) * (1 - u) + hash(i + 1) * u;
  };
  // "Ridged": el pliegue en 0.5 crea picos en punta, como una cordillera
  const ridged = (x: number) => {
    const n = vnoise(x) * 0.6 + vnoise(x * 2.3 + 11) * 0.3 + vnoise(x * 5.1 + 37) * 0.1;
    return 1 - Math.abs(2 * n - 1);
  };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const spacing = Number(canvas.dataset.spacing);
    const lift = Number(canvas.dataset.lift);
    const radius = Number(canvas.dataset.radius);
    const roughness = Number(canvas.dataset.roughness);
    const variation = Number(canvas.dataset.variation) * roughness;
    const idle = Number(canvas.dataset.idle);
    const ease = Number(canvas.dataset.ease);
    const lineWidth = Number(canvas.dataset.lineWidth);
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.3)";
    const background = canvas.dataset.background ?? "#e0dad5";
    const step = roughness > 0 ? 5 : 8; // las montañas necesitan más resolución horizontal

    const OFF = -9999;
    let width = 0;
    let height = 0;
    let px = OFF; // posición suavizada
    let py = OFF;
    let tx = OFF; // posición real del puntero
    let ty = OFF;

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      tx = clientX - rect.left;
      ty = clientY - rect.top;
      if (px === OFF) {
        px = tx;
        py = ty;
      }
    }

    function animate(time: number) {
      if (px !== OFF) {
        px += (tx - px) * ease;
        py += (ty - py) * ease;
      }
      ctx!.clearRect(0, 0, width, height);
      ctx!.strokeStyle = color;
      ctx!.fillStyle = background;
      ctx!.lineWidth = lineWidth;
      ctx!.lineJoin = "round";

      // De arriba (fondo) a abajo (frente): cada cresta tapa las líneas que quedan detrás
      for (let row = 0, y0 = spacing; y0 <= height + spacing * 2; row++, y0 += spacing) {
        // Cada fila recibe pequeñas variaciones fijas (desfase, altura y frecuencia del ruido):
        // se parecen a sus vecinas, pero no son copias desplazadas
        const shift = (hash(row * 3.7 + 1.3) - 0.5) * 3 * variation;
        const height2 = 1 + (hash(row * 5.3 + 2.1) - 0.5) * 0.8 * variation;
        const freq = 0.03 * (1 + (hash(row * 7.1 + 3.9) - 0.5) * 0.2 * variation);
        ctx!.beginPath();
        for (let x = -step; x <= width + step; x += step) {
          const dx = x - px;
          const dy = y0 - py;
          const envelope = Math.exp(-(dx * dx + dy * dy) / (radius * radius));
          // El ruido está anclado al mundo (no al puntero): las montañas "brotan" donde pasa el cursor.
          // El avance por fila (row * 0.12) hace que las contiguas se parezcan y formen cordilleras.
          const shape = 1 - roughness + roughness * (0.25 + 0.75 * ridged(x * freq + row * 0.12 + shift));
          const wave = Math.sin(x * 0.004 + row * 0.35 + time * 0.0004) * idle;
          const y = y0 - lift * envelope * shape * height2 - wave;
          if (x === -step) ctx!.moveTo(x, y);
          else ctx!.lineTo(x, y);
        }
        ctx!.stroke();
        ctx!.lineTo(width + step, y0 + spacing * 0.5);
        ctx!.lineTo(-step, y0 + spacing * 0.5);
        ctx!.closePath();
        ctx!.fill();
      }
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    requestAnimationFrame(animate);
  }

  document.querySelectorAll<HTMLCanvasElement>(".ridge-background canvas").forEach(setup);
</script>
