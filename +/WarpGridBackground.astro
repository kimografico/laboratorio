---
interface Props {
  /** Separación entre líneas de la rejilla (px) */
  size?: number;
  /** Radio de influencia de la lente (px) */
  radius?: number;
  /** Intensidad de la lente: cuánto se abre la rejilla bajo el puntero */
  lens?: number;
  /** Suavizado con el que la lente sigue al puntero (0.02 - 0.2) */
  ease?: number;
  lineWidth?: number;
  color?: string;
  background?: string;
  class?: string;
}

const {
  size = 36,
  radius = 180,
  lens = 0.6,
  ease = 0.1,
  lineWidth = 1,
  color = "rgba(0, 0, 0, 0.2)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["warp-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-radius={radius}
    data-lens={lens}
    data-ease={ease}
    data-line-width={lineWidth}
    data-color={color}></canvas>
</div>

<style>
  .warp-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const radius = Number(canvas.dataset.radius);
    const lens = Number(canvas.dataset.lens);
    const ease = Number(canvas.dataset.ease);
    const lineWidth = Number(canvas.dataset.lineWidth);
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.2)";
    const step = 10; // resolución de cada línea: más bajo = curvas más finas

    const OFF = -9999;
    let width = 0;
    let height = 0;
    let px = OFF; // posición suavizada de la lente
    let py = OFF;
    let tx = OFF; // posición real del puntero
    let ty = OFF;

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      tx = clientX - rect.left;
      ty = clientY - rect.top;
      if (px === OFF) {
        px = tx;
        py = ty;
      }
    }

    // Aleja cada vértice del centro de la lente en proporción a su distancia: efecto "ojo de pez"
    function point(x: number, y: number, first: boolean) {
      const dx = x - px;
      const dy = y - py;
      const k = 1 + lens * Math.exp(-(dx * dx + dy * dy) / (radius * radius));
      if (first) ctx!.moveTo(px + dx * k, py + dy * k);
      else ctx!.lineTo(px + dx * k, py + dy * k);
    }

    function animate() {
      if (px !== OFF) {
        px += (tx - px) * ease;
        py += (ty - py) * ease;
      }
      ctx!.clearRect(0, 0, width, height);
      ctx!.beginPath();
      for (let y = 0; y <= height + size; y += size) {
        for (let x = 0; x <= width + step; x += step) point(x, y, x === 0);
      }
      for (let x = 0; x <= width + size; x += size) {
        for (let y = 0; y <= height + step; y += step) point(x, y, y === 0);
      }
      ctx!.strokeStyle = color;
      ctx!.lineWidth = lineWidth;
      ctx!.stroke();
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".warp-background canvas").forEach(setup);
</script>
