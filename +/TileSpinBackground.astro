---
interface Props {
  /** Tamaño de la celda (px) */
  size?: number;
  /** Espacio entre baldosas (px) */
  gap?: number;
  /** Distancia de influencia del puntero (px) */
  proximity?: number;
  /** Cuánto se encoge la baldosa en el máximo (0-1): 0.65 = queda al 35% */
  shrink?: number;
  /** Giro máximo (grados). Cada baldosa gira en un sentido y con una intensidad propios */
  rotation?: number;
  /** Persistencia de la estela (0-1): más alto, estela más larga */
  decay?: number;
  /** Irregularidad (0-1): 0 = todas iguales, 1 = muy desiguales en intensidad, alcance y duración */
  randomness?: number;
  /** Opacidad base de las baldosas (0-1) */
  alpha?: number;
  /** Variación aleatoria fija de la opacidad de cada baldosa (± puntos de opacidad: 0.04 = ±4%) */
  alphaJitter?: number;
  color?: string;
  background?: string;
  class?: string;
}

const {
  size = 28,
  gap = 4,
  proximity = 220,
  shrink = 0.85,
  rotation = 35,
  decay = 0.97,
  randomness = 0.6,
  alpha = 0.08,
  alphaJitter = 0.04,
  color = "#000000",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["tilespin-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-gap={gap}
    data-proximity={proximity}
    data-shrink={shrink}
    data-rotation={rotation}
    data-decay={decay}
    data-randomness={randomness}
    data-alpha={alpha}
    data-alpha-jitter={alphaJitter}
    data-color={color}></canvas>
</div>

<style>
  .tilespin-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Tile = { x: number; y: number; level: number; shown: number; gain: number; reach: number; fade: number; dir: number; alpha: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const gap = Number(canvas.dataset.gap);
    const proximity = Number(canvas.dataset.proximity);
    const shrink = Number(canvas.dataset.shrink);
    const maxAngle = (Number(canvas.dataset.rotation) * Math.PI) / 180;
    const decay = Number(canvas.dataset.decay);
    const randomness = Number(canvas.dataset.randomness);
    const alpha = Number(canvas.dataset.alpha);
    const alphaJitter = Number(canvas.dataset.alphaJitter);
    const color = canvas.dataset.color ?? "#000";

    let width = 0;
    let height = 0;
    let tiles: Tile[] = [];

    function build() {
      const columns = Math.ceil(width / size);
      const rows = Math.ceil(height / size);
      tiles = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          tiles.push({
            x: col * size + size / 2, // centro de la baldosa
            y: row * size + size / 2,
            level: 0,
            shown: 0,
            // Valores aleatorios fijos por baldosa
            gain: 1 - randomness * Math.random(),
            reach: 1 - randomness * 0.5 * Math.random(),
            fade: decay - randomness * 0.04 * Math.random(),
            dir: (Math.random() < 0.5 ? -1 : 1) * (0.5 + 0.5 * Math.random()), // sentido e intensidad del giro
            alpha: Math.max(0.01, alpha + (Math.random() * 2 - 1) * alphaJitter), // opacidad propia
          });
        }
      }
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      build();
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      for (const t of tiles) {
        const d = Math.hypot(t.x - px, t.y - py);
        const influence = (1 - Math.min(d / (proximity * t.reach), 1)) * t.gain;
        t.level = Math.max(t.level, influence);
      }
    }

    function animate() {
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = color;
      const side = size - gap;
      for (const t of tiles) {
        t.shown += (t.level - t.shown) * 0.2;
        t.level *= t.fade;
        const s = side * (1 - shrink * t.shown);
        const a = t.dir * maxAngle * t.shown;
        const cos = Math.cos(a);
        const sin = Math.sin(a);
        // Una sola transformación por baldosa: giro alrededor de su centro
        ctx!.globalAlpha = t.alpha;
        ctx!.setTransform(cos, sin, -sin, cos, t.x, t.y);
        ctx!.fillRect(-s / 2, -s / 2, s, s);
      }
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".tilespin-background canvas").forEach(setup);
</script>
