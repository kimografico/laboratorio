---
interface Props {
  /** Número de partículas */
  count?: number;
  /** Velocidad de las partículas (px por fotograma) */
  speed?: number;
  /** Escala del campo: más bajo = corrientes más amplias */
  scale?: number;
  /** Radio en el que el puntero repele las partículas (px) */
  radius?: number;
  /** Fuerza de repulsión del puntero */
  push?: number;
  /** Rapidez con la que se borra la estela (0.02 = larga, 0.15 = corta) */
  fade?: number;
  lineWidth?: number;
  /** Color de las partículas (con transparencia) */
  color?: string;
  background?: string;
  class?: string;
}

const {
  count = 800,
  speed = 1.1,
  scale = 0.0035,
  radius = 140,
  push = 3,
  fade = 0.07,
  lineWidth = 1,
  color = "rgba(0, 0, 0, 0.45)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["flow-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-count={count}
    data-speed={speed}
    data-scale={scale}
    data-radius={radius}
    data-push={push}
    data-fade={fade}
    data-line-width={lineWidth}
    data-color={color}
    data-background={background}></canvas>
</div>

<style>
  .flow-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Particle = { x: number; y: number; life: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const count = Number(canvas.dataset.count);
    const speed = Number(canvas.dataset.speed);
    const scale = Number(canvas.dataset.scale);
    const radius = Number(canvas.dataset.radius);
    const push = Number(canvas.dataset.push);
    const fade = Number(canvas.dataset.fade);
    const lineWidth = Number(canvas.dataset.lineWidth);
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.45)";
    const background = canvas.dataset.background ?? "#e0dad5";

    let width = 0;
    let height = 0;
    let time = 0;
    let px = -9999;
    let py = -9999;
    let particles: Particle[] = [];

    const spawn = (p: Particle) => {
      p.x = Math.random() * width;
      p.y = Math.random() * height;
      p.life = 100 + Math.random() * 200;
    };

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      ctx!.fillStyle = background;
      ctx!.fillRect(0, 0, width, height);
      particles = Array.from({ length: count }, () => {
        const p = { x: 0, y: 0, life: 0 };
        spawn(p);
        return p;
      });
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      px = clientX - rect.left;
      py = clientY - rect.top;
    }

    // Campo de corrientes suave: el ángulo depende de la posición y del tiempo
    const angle = (x: number, y: number) =>
      (Math.sin(x * scale + time * 2) + Math.cos(y * scale * 1.3 - time) + Math.sin((x + y) * scale * 0.5)) * Math.PI;

    function animate() {
      time += 0.003;
      // En lugar de borrar, se pinta el fondo con poca opacidad: así queda la estela
      ctx!.globalAlpha = fade;
      ctx!.fillStyle = background;
      ctx!.fillRect(0, 0, width, height);
      ctx!.globalAlpha = 1;

      ctx!.beginPath();
      for (const p of particles) {
        const a = angle(p.x, p.y);
        let vx = Math.cos(a) * speed;
        let vy = Math.sin(a) * speed;

        const dx = p.x - px;
        const dy = p.y - py;
        const d = Math.hypot(dx, dy);
        if (d < radius && d > 0) {
          const f = (1 - d / radius) * push;
          vx += (dx / d) * f;
          vy += (dy / d) * f;
        }

        ctx!.moveTo(p.x, p.y);
        p.x += vx;
        p.y += vy;
        ctx!.lineTo(p.x, p.y);

        if (--p.life <= 0 || p.x < 0 || p.x > width || p.y < 0 || p.y > height) spawn(p);
      }
      ctx!.strokeStyle = color;
      ctx!.lineWidth = lineWidth;
      ctx!.stroke();
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".flow-background canvas").forEach(setup);
</script>
