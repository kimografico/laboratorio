---
interface Props {
  /** Separación entre líneas (px) */
  size?: number;
  /** Longitud base de cada línea (px) */
  length?: number;
  /** Alargamiento máximo cerca del puntero (px) */
  growth?: number;
  /** Distancia de influencia del puntero (px) */
  proximity?: number;
  /** Suavizado: cuanto más bajo, más lento y fluido */
  ease?: number;
  /** Ángulo de reposo (grados) */
  restAngle?: number;
  /** Grosor de la línea (px) */
  lineWidth?: number;
  /** Color de las líneas (negro con mucha transparencia) */
  color?: string;
  /** Color de fondo */
  background?: string;
  class?: string;
}

const {
  size = 32,
  length = 10,
  growth = 8,
  proximity = 220,
  ease = 0.06,
  restAngle = 45,
  lineWidth = 1.5,
  color = "rgba(0, 0, 0, 0.18)",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["needle-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-length={length}
    data-growth={growth}
    data-proximity={proximity}
    data-ease={ease}
    data-rest-angle={restAngle}
    data-line-width={lineWidth}
    data-color={color}></canvas>
</div>

<style>
  .needle-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Needle = { x: number; y: number; len: number; angle: number; targetLen: number; targetAngle: number };

  const TAU = Math.PI * 2;
  // Diferencia angular más corta entre dos ángulos, en el rango [-PI, PI]
  const delta = (from: number, to: number) => ((((to - from) % TAU) + TAU + Math.PI) % TAU) - Math.PI;

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const baseLength = Number(canvas.dataset.length);
    const growth = Number(canvas.dataset.growth);
    const proximity = Number(canvas.dataset.proximity);
    const ease = Number(canvas.dataset.ease);
    const rest = (Number(canvas.dataset.restAngle) * Math.PI) / 180;
    const lineWidth = Number(canvas.dataset.lineWidth);
    const color = canvas.dataset.color ?? "rgba(0,0,0,0.18)";

    let width = 0;
    let height = 0;
    let needles: Needle[] = [];

    function build() {
      const columns = Math.ceil(width / size) + 1;
      const rows = Math.ceil(height / size) + 1;
      needles = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          needles.push({
            x: col * size,
            y: row * size,
            len: baseLength,
            angle: rest,
            targetLen: baseLength,
            targetAngle: rest,
          });
        }
      }
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      build();
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      for (const n of needles) {
        const dx = px - n.x;
        const dy = py - n.y;
        const t = 1 - Math.min(Math.hypot(dx, dy) / proximity, 1);
        const toPointer = Math.atan2(dy, dx);
        // Mezcla entre el ángulo de reposo y la dirección al puntero según la cercanía
        n.targetAngle = rest + delta(rest, toPointer) * t;
        n.targetLen = baseLength + growth * t;
      }
    }

    function animate() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.beginPath();
      for (const n of needles) {
        n.angle += delta(n.angle, n.targetAngle) * ease;
        n.len += (n.targetLen - n.len) * ease;
        const hx = (Math.cos(n.angle) * n.len) / 2;
        const hy = (Math.sin(n.angle) * n.len) / 2;
        ctx!.moveTo(n.x - hx, n.y - hy);
        ctx!.lineTo(n.x + hx, n.y + hy);
      }
      ctx!.strokeStyle = color;
      ctx!.lineWidth = lineWidth;
      ctx!.lineCap = "round";
      ctx!.stroke();
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document
    .querySelectorAll<HTMLCanvasElement>(".needle-background canvas")
    .forEach(setup);
</script>
