---
interface Props {
  /** Tamaño de la celda (px) */
  size?: number;
  /** Espacio entre baldosas (px) */
  gap?: number;
  /** Distancia de influencia del puntero (px) */
  proximity?: number;
  /** Opacidad en reposo */
  baseAlpha?: number;
  /** Opacidad máxima al paso del puntero */
  maxAlpha?: number;
  /** Persistencia de la estela (0-1): más alto, estela más larga */
  decay?: number;
  /** Irregularidad (0-1): 0 = todas iguales, 1 = muy desiguales en intensidad, alcance y duración */
  randomness?: number;
  /** Color sólido: la opacidad se controla con baseAlpha y maxAlpha */
  color?: string;
  background?: string;
  class?: string;
}

const {
  size = 28,
  gap = 4,
  proximity = 140,
  baseAlpha = 0.04,
  maxAlpha = 0.22,
  decay = 0.97,
  randomness = 0.6,
  color = "#000000",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["tile-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-size={size}
    data-gap={gap}
    data-proximity={proximity}
    data-base-alpha={baseAlpha}
    data-max-alpha={maxAlpha}
    data-decay={decay}
    data-randomness={randomness}
    data-color={color}></canvas>
</div>

<style>
  .tile-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Tile = { x: number; y: number; level: number; shown: number; gain: number; reach: number; fade: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const size = Number(canvas.dataset.size);
    const gap = Number(canvas.dataset.gap);
    const proximity = Number(canvas.dataset.proximity);
    const baseAlpha = Number(canvas.dataset.baseAlpha);
    const maxAlpha = Number(canvas.dataset.maxAlpha);
    const decay = Number(canvas.dataset.decay);
    const randomness = Number(canvas.dataset.randomness);
    const color = canvas.dataset.color ?? "#000";

    let width = 0;
    let height = 0;
    let tiles: Tile[] = [];

    function build() {
      const columns = Math.ceil(width / size);
      const rows = Math.ceil(height / size);
      tiles = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          tiles.push({
            x: col * size,
            y: row * size,
            level: 0,
            shown: 0,
            // Valores aleatorios fijos por baldosa: intensidad, alcance y duración de la estela
            gain: 1 - randomness * Math.random(),
            reach: 1 - randomness * 0.5 * Math.random(),
            fade: decay - randomness * 0.04 * Math.random(),
          });
        }
      }
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      build();
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      for (const t of tiles) {
        const d = Math.hypot(t.x + size / 2 - px, t.y + size / 2 - py);
        const influence = (1 - Math.min(d / (proximity * t.reach), 1)) * t.gain;
        // La luz sube con el puntero y luego se apaga sola en animate()
        t.level = Math.max(t.level, influence);
      }
    }

    function animate() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = color;
      const side = size - gap;
      for (const t of tiles) {
        t.shown += (t.level - t.shown) * 0.25;
        t.level *= t.fade;
        ctx!.globalAlpha = baseAlpha + t.shown * (maxAlpha - baseAlpha);
        ctx!.fillRect(t.x + gap / 2, t.y + gap / 2, side, side);
      }
      ctx!.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".tile-background canvas").forEach(setup);
</script>
