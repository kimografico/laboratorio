---
/**
 * FlipText.astro — port a Astro del <FlipText> de Vengeance UI.
 * Sin JS en cliente: el texto se divide en el servidor y la animación es CSS puro.
 *
 * Uso:
 *   <FlipText class="text-4xl font-bold">Your amazing text here</FlipText>
 *   <FlipText duration={1.6} loop={false} together>Todo a la vez</FlipText>
 */
interface Props {
  class?: string;
  /** Duración de un ciclo completo (giro + pausa) en segundos. El giro ocupa el 30 %, el resto es pausa */
  duration?: number;
  /** Retraso inicial en segundos */
  delay?: number;
  /** Bucle infinito o una sola vez */
  loop?: boolean;
  /** Separador para dividir el texto en "palabras" */
  separator?: string;
  /** Si es true, todos los caracteres animan a la vez (sin stagger) */
  together?: boolean;
}

const {
  class: className,
  duration = 4.5,
  delay = 0,
  loop = true,
  separator = " ",
  together = false,
} = Astro.props;

const text = (await Astro.slots.render("default")).trim();
const words = text.split(separator);
const totalChars = text.length;

// Misma lógica de stagger que el original: curva senoidal sobre el índice global
let offset = 0;
const wordData = words.map((word) => {
  const chars = [...word].map((char, i) => {
    const globalIndex = offset + i;
    const d = together
      ? delay
      : Math.sin((globalIndex / totalChars) * (Math.PI / 2)) * (duration * 0.25) + delay;
    return { char, delay: d };
  });
  offset += word.length + separator.length;
  return chars;
});
---

<div
  class:list={["flip-text-wrapper", className]}
  aria-label={text}
  style={`--flip-duration:${duration}s;--flip-iteration:${loop ? "infinite" : "1"}`}
>
  {
    wordData.map((chars, wi) => (
      <span class="word" aria-hidden="true">
        {chars.map(({ char, delay }) => (
          <span class="flip-char" data-char={char} style={`--flip-delay:${delay}s`}>
            <span class="face">{char}</span>
          </span>
        ))}
        {wi < wordData.length - 1 && <span class="separator">{separator}</span>}
      </span>
    ))
  }
</div>

<style is:global>
  /* Progreso del giro (0 → 1). Registrada para poder animarla y derivar
     de ella el giro 3D y la opacidad de cada cara. */
  @property --flip-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .flip-text-wrapper {
    display: inline-block;
    line-height: 1; /* importante: la cara oculta mide exactamente 1em */
    perspective: 1000px;
  }

  .flip-text-wrapper .word {
    display: inline-block;
    white-space: nowrap;
    transform-style: preserve-3d;
  }

  .flip-text-wrapper .separator {
    display: inline-block;
    white-space: pre;
  }

  .flip-text-wrapper .flip-char {
    display: inline-block;
    position: relative;
    white-space: pre;
    transform-style: preserve-3d;
    transform-origin: 50% 50% -0.5em; /* eje en el centro de un cubo de 1em */
    transform: rotateX(calc(var(--flip-p) * 90deg));
    animation: flip-roll var(--flip-duration) cubic-bezier(0.65, 0, 0.35, 1)
      var(--flip-delay) var(--flip-iteration) both;
  }

  /* Cara frontal: se desvanece antes de quedar de canto (p ≈ 0.83 → opacidad 0) */
  .flip-text-wrapper .face {
    display: inline-block;
    backface-visibility: hidden;
    opacity: calc(1 - var(--flip-p) * 1.2);
  }

  /* Cara inferior del cubo: invisible hasta que ya está bastante girada */
  .flip-text-wrapper .flip-char::after {
    content: attr(data-char);
    position: absolute;
    left: 0;
    top: 100%;
    transform-origin: top;
    transform: rotateX(-90deg);
    backface-visibility: hidden;
    opacity: calc(var(--flip-p) * 1.2 - 0.2);
  }

  /* Gira en el primer 30 % y descansa el resto. En 30.01 % vuelve a 0:
     la cara inferior es idéntica a la frontal, así que el salto no se nota. */
  @keyframes flip-roll {
    0%      { --flip-p: 0; }
    30%     { --flip-p: 1; }
    30.01%  { --flip-p: 0; }
    100%    { --flip-p: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-text-wrapper .flip-char { animation: none; }
  }
</style>
