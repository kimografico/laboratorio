---
interface Props {
  /** Número de anillos */
  count?: number;
  /** Desplazamiento máximo por paralaje (px) para los anillos más cercanos */
  strength?: number;
  /** Suavizado del paralaje: cuanto más bajo, más lento */
  ease?: number;
  /** Opacidad máxima de los anillos (0-1) */
  alpha?: number;
  lineWidth?: number;
  color?: string;
  background?: string;
  class?: string;
}

const {
  count = 14,
  strength = 80,
  ease = 0.03,
  alpha = 0.2,
  lineWidth = 1,
  color = "#000000",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["rings-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-count={count}
    data-strength={strength}
    data-ease={ease}
    data-alpha={alpha}
    data-line-width={lineWidth}
    data-color={color}></canvas>
</div>

<style>
  .rings-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Ring = { fx: number; fy: number; r: number; z: number; phase: number; filled: boolean };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const count = Number(canvas.dataset.count);
    const strength = Number(canvas.dataset.strength);
    const ease = Number(canvas.dataset.ease);
    const alpha = Number(canvas.dataset.alpha);
    const lineWidth = Number(canvas.dataset.lineWidth);
    const color = canvas.dataset.color ?? "#000";

    let width = 0;
    let height = 0;
    let rings: Ring[] = [];
    // Posición del puntero normalizada (-0.5 a 0.5), objetivo y suavizada
    let tx = 0;
    let ty = 0;
    let sx = 0;
    let sy = 0;

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      const maxR = Math.min(width, height) * 0.2;
      rings = Array.from({ length: count }, () => {
        const r = maxR * (0.2 + Math.random() * 0.8);
        // Los anillos grandes se sienten más cercanos: se mueven más con el puntero
        return { fx: Math.random(), fy: Math.random(), r, z: 0.2 + 0.8 * (r / maxR), phase: Math.random() * Math.PI * 2, filled: Math.random() < 0.3 };
      });
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      tx = (clientX - rect.left) / width - 0.5;
      ty = (clientY - rect.top) / height - 0.5;
    }

    function animate(time: number) {
      sx += (tx - sx) * ease;
      sy += (ty - sy) * ease;
      ctx!.clearRect(0, 0, width, height);
      ctx!.strokeStyle = color;
      ctx!.fillStyle = color;
      ctx!.lineWidth = lineWidth;
      for (const r of rings) {
        const x = r.fx * width - sx * strength * 2 * r.z + Math.cos(time * 0.00015 + r.phase) * 14;
        const y = r.fy * height - sy * strength * 2 * r.z + Math.sin(time * 0.00012 + r.phase) * 14;
        ctx!.beginPath();
        ctx!.arc(x, y, r.r, 0, Math.PI * 2);
        if (r.filled) {
          ctx!.globalAlpha = alpha * 0.25 * r.z;
          ctx!.fill();
        }
        ctx!.globalAlpha = alpha * (0.4 + 0.6 * r.z);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    requestAnimationFrame(animate);
  }

  document.querySelectorAll<HTMLCanvasElement>(".rings-background canvas").forEach(setup);
</script>
