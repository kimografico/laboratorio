---
interface Props {
  /** Puntos por cada 10.000 px² del contenedor */
  density?: number;
  /** Distancia máxima para que dos puntos se unan (px) */
  link?: number;
  /** Velocidad de deriva (px por fotograma) */
  speed?: number;
  /** Radio en el que el puntero atrae y conecta puntos (px) */
  radius?: number;
  /** Fuerza de atracción del puntero */
  attract?: number;
  /** Radio de cada punto (px) */
  dot?: number;
  color?: string;
  background?: string;
  class?: string;
}

const {
  density = 0.6,
  link = 120,
  speed = 0.3,
  radius = 200,
  attract = 0.04,
  dot = 1.6,
  color = "#000000",
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["network-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-density={density}
    data-link={link}
    data-speed={speed}
    data-radius={radius}
    data-attract={attract}
    data-dot={dot}
    data-color={color}></canvas>
</div>

<style>
  .network-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; bx: number; by: number };

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const density = Number(canvas.dataset.density);
    const link = Number(canvas.dataset.link);
    const speed = Number(canvas.dataset.speed);
    const radius = Number(canvas.dataset.radius);
    const attract = Number(canvas.dataset.attract);
    const dotSize = Number(canvas.dataset.dot);
    const color = canvas.dataset.color ?? "#000";

    let width = 0;
    let height = 0;
    let px = -9999;
    let py = -9999;
    let nodes: Node[] = [];

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      const count = Math.round((density * width * height) / 10000);
      nodes = Array.from({ length: count }, () => {
        const bx = (Math.random() - 0.5) * 2 * speed;
        const by = (Math.random() - 0.5) * 2 * speed;
        return { x: Math.random() * width, y: Math.random() * height, vx: bx, vy: by, bx, by };
      });
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      px = clientX - rect.left;
      py = clientY - rect.top;
    }

    function line(x1: number, y1: number, x2: number, y2: number, a: number) {
      ctx!.globalAlpha = a;
      ctx!.beginPath();
      ctx!.moveTo(x1, y1);
      ctx!.lineTo(x2, y2);
      ctx!.stroke();
    }

    function animate() {
      ctx!.clearRect(0, 0, width, height);
      for (const n of nodes) {
        // La velocidad vuelve poco a poco a la deriva propia; el puntero atrae a los cercanos
        n.vx += (n.bx - n.vx) * 0.02;
        n.vy += (n.by - n.vy) * 0.02;
        const dx = px - n.x;
        const dy = py - n.y;
        const d = Math.hypot(dx, dy);
        if (d < radius && d > 1) {
          const f = attract * (1 - d / radius);
          n.vx += (dx / d) * f;
          n.vy += (dy / d) * f;
        }
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0) n.x += width;
        else if (n.x > width) n.x -= width;
        if (n.y < 0) n.y += height;
        else if (n.y > height) n.y -= height;
      }

      ctx!.strokeStyle = color;
      ctx!.fillStyle = color;
      ctx!.lineWidth = 1;
      const link2 = link * link;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d2 = (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
          if (d2 < link2) line(a.x, a.y, b.x, b.y, 0.25 * (1 - Math.sqrt(d2) / link));
        }
        // El puntero actúa como un nodo más, con líneas más marcadas
        const d = Math.hypot(a.x - px, a.y - py);
        if (d < radius) line(a.x, a.y, px, py, 0.5 * (1 - d / radius));
      }

      ctx!.globalAlpha = 0.35;
      ctx!.beginPath();
      for (const n of nodes) {
        ctx!.moveTo(n.x + dotSize, n.y);
        ctx!.arc(n.x, n.y, dotSize, 0, Math.PI * 2);
      }
      ctx!.fill();
      ctx!.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".network-background canvas").forEach(setup);
</script>
