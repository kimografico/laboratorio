---
interface Props {
  /** Colores de las manchas (hex de 6 dígitos). Una mancha por color */
  colors?: string[];
  /** Radio de cada mancha como fracción del lado menor del contenedor */
  size?: number;
  /** Opacidad del centro de cada mancha (0-1) */
  opacity?: number;
  /** Suavizado base: cuanto más bajo, más lento (cada mancha va un poco más lenta que la anterior) */
  ease?: number;
  /** Fuerza con la que las manchas huyen del puntero (0 = lo ignoran, 1 = huyen mucho) */
  avoid?: number;
  background?: string;
  class?: string;
}

const {
  colors = ["#ee3d3d", "#f5a623", "#2b4eff"],
  size = 0.55,
  opacity = 0.5,
  ease = 0.012,
  avoid = 0.8,
  background = "#e0dad5",
  class: className,
} = Astro.props;
---

<div class:list={["aurora-background", className]} style={`background-color: ${background};`}>
  <canvas
    data-colors={JSON.stringify(colors)}
    data-size={size}
    data-opacity={opacity}
    data-ease={ease}
    data-avoid={avoid}></canvas>
</div>

<style>
  .aurora-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Blob = { rgb: string; x: number; y: number; ease: number; phase: number };

  function hexToRgb(hex: string) {
    const n = parseInt(hex.replace("#", ""), 16);
    return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
  }

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const colors: string[] = JSON.parse(canvas.dataset.colors ?? "[]");
    const sizeFactor = Number(canvas.dataset.size);
    const opacity = Number(canvas.dataset.opacity);
    const baseEase = Number(canvas.dataset.ease);
    const avoid = Number(canvas.dataset.avoid);

    let width = 0;
    let height = 0;
    let hasPointer = false;
    let tx = 0;
    let ty = 0;

    const blobs: Blob[] = colors.map((c, i) => ({
      rgb: hexToRgb(c),
      x: 0,
      y: 0,
      ease: baseEase * (1 - i * 0.25), // cada mancha llega un poco más tarde: efecto de estela
      phase: i * 2.1,
    }));

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width;
      canvas.height = height;
      for (const b of blobs) {
        b.x = width / 2;
        b.y = height / 2;
      }
    }

    function onPointer(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      tx = clientX - rect.left;
      ty = clientY - rect.top;
      hasPointer = true;
    }

    function animate(time: number) {
      const radius = Math.min(width, height) * sizeFactor;
      ctx!.clearRect(0, 0, width, height);
      for (const b of blobs) {
        // Cada mancha flota por su órbita; si el puntero se acerca a su destino, la empuja lejos
        let targetX = width / 2 + Math.cos(time * 0.0004 + b.phase) * width * 0.22;
        let targetY = height / 2 + Math.sin(time * 0.0005 + b.phase) * height * 0.18;
        if (hasPointer) {
          const dx = targetX - tx;
          const dy = targetY - ty;
          const d = Math.hypot(dx, dy) || 1;
          const t = Math.max(0, 1 - d / radius);
          targetX += (dx / d) * radius * avoid * t;
          targetY += (dy / d) * radius * avoid * t;
        }
        b.x += (targetX - b.x) * b.ease;
        b.y += (targetY - b.y) * b.ease;

        const g = ctx!.createRadialGradient(b.x, b.y, 0, b.x, b.y, radius);
        g.addColorStop(0, `rgba(${b.rgb}, ${opacity})`);
        g.addColorStop(1, `rgba(${b.rgb}, 0)`);
        ctx!.fillStyle = g;
        ctx!.fillRect(0, 0, width, height);
      }
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("mousemove", (e) => onPointer(e.clientX, e.clientY));
    window.addEventListener(
      "touchmove",
      (e) => onPointer(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );

    resize();
    requestAnimationFrame(animate);
  }

  document.querySelectorAll<HTMLCanvasElement>(".aurora-background canvas").forEach(setup);
</script>
