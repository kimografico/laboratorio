{
  "name": "@kimografico/laboratorio",
  "version": "0.1.0",
  "description": "Fondos interactivos (canvas) y componentes de UI en React para Astro, Next.js o Vite.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./theme.css": "./src/styles/theme.css",
    "./backgrounds/base.css": "./src/components/backgrounds/base.css",
    "./texts/*.css": "./src/components/texts/*.css",
    "./backgrounds/*": {
      "types": "./dist/backgrounds/*.d.ts",
      "import": "./dist/backgrounds/*.js"
    },
    "./texts/*": {
      "types": "./dist/texts/*.d.ts",
      "import": "./dist/texts/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    }
  },
  "files": [
    "dist",
    "src/components/**/*.css",
    "src/styles/theme.css",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:lib": "tsup",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "lucide-react": "^1.57.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
