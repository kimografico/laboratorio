---
import Layout from "../../layouts/Layout.astro";
import Gallery, { type ExperimentMeta } from "../../components/ui/Gallery";
import GridIcon from "../../components/ui/icons/GridIcon.astro";
import AtomIcon from "../../components/ui/icons/AtomIcon.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("ui");

const pieces: ExperimentMeta[] = entries
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    component: entry.data.component,
    props: entry.data.props,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

const icons = [
  { name: "Grid", Icon: GridIcon },
  { name: "Atom", Icon: AtomIcon },
];
---

<Layout
  title="Piezas de Interfaz · Laboratorio"
  description="Botones configurables y piezas de interfaz reutilizables del Laboratorio.">
  <section class="mx-auto max-w-6xl 2xl:max-w-8xl px-5 pb-10 pt-16">
    <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-fg sm:text-5xl">
      Piezas de Interfaz
    </h1>
    <p class="mt-4 max-w-2xl text-base text-muted">
      Botones configurables con playground. Abre cualquiera para ajustar sus props y copiar el código.
    </p>
  </section>

  <Gallery client:load experiments={pieces} basePath="/ui" />

  <section class="mx-auto max-w-6xl 2xl:max-w-8xl px-5 pb-24 pt-16">
    <h2 class="text-2xl font-semibold text-fg">Iconos</h2>
    <div class="mt-6 grid grid-cols-6 gap-6">
      {icons.map(({ name, Icon }) => (
        <div class="flex flex-col items-center gap-4 rounded-2xl border border-line bg-panel p-8 text-center text-fg">
          <Icon class="h-12 w-12" />
          <h3 class="text-base font-semibold text-fg">{name}</h3>
        </div>
      ))}
    </div>
  </section>
</Layout>
