---
import Layout from "../../layouts/Layout.astro";
import ExperimentPreview from "../../components/ui/ExperimentPreview";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("experiments");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, component, accent, props } = entry.data;
---

<Layout title={`${title} · Laboratorio`} description={description}>
  <section class="mx-auto max-w-6xl px-5 pt-10 pb-16">
    <div class="mb-8 flex flex-col gap-4 border-b border-white/10 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span
          class="inline-block h-2.5 w-2.5 rounded-full"
          style={`background-color: ${accent ?? "#ffffff"}`}></span>
        <span class="text-xs uppercase tracking-wide text-white/45">{category}</span>
        <span class="text-xs text-white/25">/</span>
        <code class="text-xs text-white/45">{component}</code>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
      <p class="max-w-3xl text-base text-white/60">{description}</p>
    </div>

    <ExperimentPreview
      client:only="react"
      componentId={component}
      propDefs={props}
      category={category}
      accent={accent}
    />

    <article class="exp-content mt-12 max-w-3xl">
      <Content />
    </article>
  </section>
</Layout>
