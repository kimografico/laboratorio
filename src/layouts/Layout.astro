---
import "../styles/global.css";
import AtomIcon from "../components/ui/icons/AtomIcon.astro";
import ThemeToggle from "../components/ui/ThemeToggle";
import { base, withBase } from "../lib/base";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Laboratorio · Interactive Backgrounds",
  description = "Colección de fondos interactivos y componentes de texto hechos en React, listos para Astro y otros frameworks.",
} = Astro.props;

const path = Astro.url.pathname.slice(base.length) || "/";
const isExperiments = path === "/" || path.startsWith("/experiment");
const isUi = path.startsWith("/ui");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var light = stored
            ? stored === "light"
            : window.matchMedia("(prefers-color-scheme: light)").matches;
          if (light) document.documentElement.classList.add("light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-6xl 2xl:max-w-8xl items-center justify-between px-5 py-4">
        <a href={withBase("/")} class="group inline-flex items-center gap-2.5">
          <AtomIcon class="h-8 w-8 text-fg" />
          <span class="text-sm font-semibold tracking-tight text-fg">
            @kimografico<span class="text-faint">/laboratorio</span>
          </span>
        </a>
        <div class="flex items-center gap-4">
          <nav class="flex items-center gap-1 text-sm">
            <a
              href={withBase("/")}
              class={`rounded-lg px-3 py-1.5 transition ${
                isExperiments ? "font-semibold text-fg" : "text-muted hover:text-fg"
              }`}
              >Experimentos</a
            >
            <a
              href={withBase("/ui")}
              class={`rounded-lg px-3 py-1.5 transition ${
                isUi ? "font-semibold text-fg" : "text-muted hover:text-fg"
              }`}
              >UI</a
            >
          </nav>
          <ThemeToggle client:load interactive size="sm" />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line py-8">
      <div class="mx-auto max-w-6xl 2xl:max-w-8xl px-5 text-center text-xs text-faint">
        © 2026 kimografico
      </div>
    </footer>
  </body>
</html>
