---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = "h-8 w-8", label = "Info" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  viewBox="0 0 24 24"
  class={className}
  role="img"
  aria-label={label}>
  <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.5" />
  <circle cx="12" cy="7.75" r="1.15" fill="currentColor">
    <animate
      attributeName="r"
      dur="2.4s"
      values="1.15;1.5;1.15"
      repeatCount="indefinite"
      calcMode="spline"
      keySplines="0.4 0 0.2 1;0.4 0 0.2 1"
      keyTimes="0;0.5;1"
    />
  </circle>
  <rect x="11.15" y="10.5" width="1.7" height="6" rx="0.85" fill="currentColor" />
</svg>
